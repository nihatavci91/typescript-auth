PORT=3000

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Yalnızca yerel geliştirme içindir.
MYSQL_ROOT_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_HOST=%
MYSQL_DATABASE=ts_auth_api

# Container içinden localhost değil, Compose servis adı olan mysql kullanılır.
DATABASE_URL=mysql://root:replace_with_a_strong_password@mysql:3306/ts_auth_api

DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=replace_with_a_strong_password
DATABASE_NAME=ts_auth_api
